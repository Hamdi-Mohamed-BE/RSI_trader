{
  "name": "aaa-eas-builder-assets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "css:build": "tailwindcss -i ./assets/css/app.css -o ./static/css/app.css --minify",
    "css:watch": "tailwindcss -i ./assets/css/app.css -o ./static/css/app.css --watch",
    "js:build": "node ./scripts/build-frontend.mjs",
    "assets:build": "npm run css:build && npm run js:build"
  },
  "dependencies": {
    "alpinejs": "^3.14.0",
    "htmx.org": "^2.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "tailwindcss": "^4.1.0"
  }
}
