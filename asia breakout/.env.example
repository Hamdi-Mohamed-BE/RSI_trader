MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Trading remains disabled until both switches are deliberately changed.
ENABLE_TRADING=false
DRY_RUN=true

RISK_PCT=3.0
MAX_BASKET_RISK_PCT=6.0
STARTING_BALANCE=1000
ASIA_START_UTC=00:00
ASIA_END_UTC=08:00
ENTRY_CUTOFF_UTC=13:00
FORCE_EXIT_UTC=17:00
ADR_DAYS=14
MAGIC=290729
LOG_DIR=logs
LOG_LEVEL=INFO

# These defaults are replaced with the robust optimization winner after testing.
ENTRY_MODE=confirmed_close
STOP_MODE=midpoint
RR=1.5
EXIT_MODE=fixed
TRAIL_START_R=1.0
TRAIL_DISTANCE_R=1.0
BUFFER_RANGE_FRACTION=0.03
MIN_RANGE_ADR_FRACTION=0.05
MAX_RANGE_ADR_FRACTION=0.50
RETEST_BARS=4

# Exact names, prefixes, and suffixes are discovered from the connected broker.
# Optional override: SYMBOLS=XAUUSD,BTCUSD
SYMBOL_CONFIG_PATH=configs\pf3_basket.json
