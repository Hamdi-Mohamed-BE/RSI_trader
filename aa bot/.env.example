# Public market data works without credentials.
PORT=8787
COINBASE_REST_URL=https://api.exchange.coinbase.com
COINBASE_WS_URL=wss://ws-feed.exchange.coinbase.com
COINBASE_PRODUCTS=BTC-USD,ETH-USD
COINBASE_PRIMARY_MODE=full
COINBASE_REST_TIMEOUT_MS=15000

# Required only when authenticated Coinbase execution is added/enabled.
COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_API_PASSPHRASE=

# Optional integrations.
OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MT5_BRIDGE_URL=
MT5_BRIDGE_TOKEN=

# Safety: the platform starts in analysis/paper mode.
ENABLE_LIVE_EXECUTION=false
DEFAULT_ACCOUNT_SIZE=50000
MAX_RISK_PCT=0.5
