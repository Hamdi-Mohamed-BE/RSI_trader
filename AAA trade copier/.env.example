APP_ENV=development
APP_SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///./storage/trade_copier.db
WEB_HOST=127.0.0.1
WEB_PORT=8100
LOG_LEVEL=INFO

# Live trading is disabled unless both values are explicitly changed.
SAFE_MODE=true
LIVE_EXECUTION_ENABLED=false
DEMO_MODE=false
AUTO_DETECT_MT5=true
MT5_TEMPLATE_PATH=

# Optional one-time local administrator bootstrap.
ADMIN_EMAIL=admin@aaa.local
ADMIN_PASSWORD=

# Copier runtime.
HEARTBEAT_TIMEOUT_SECONDS=15
MT5_DISCOVERY_INTERVAL_SECONDS=5
MAX_FOLLOWER_ACCOUNTS=10
MASTER_PIPE_NAME=aaa_trade_copier_master
FOLLOWER_PIPE_PREFIX=aaa_trade_copier_follower
CONTINUOUS_COPY_ENABLED=true
CONTINUOUS_COPY_POLL_MS=1000
AUTO_INSTALL_MT5_AGENTS=true
