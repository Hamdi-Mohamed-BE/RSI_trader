# Research and scanner settings
CANONICAL_SYMBOL=XAUUSD
ANALYSIS_TIMEFRAME=H1
EXECUTION_TIMEFRAME=M15
HISTORY_DAYS=180
RISK_PCT=2.5
MAX_PORTFOLIO_RISK_PCT=2.5
MIN_RR=2.0
PROFILE_ROWS=128
VALUE_AREA_PCT=70
ZONE_LOOKBACK=500
ZONE_MAX_TOUCHES=2
# EM2/EM4 remain implemented for research but are not live defaults until
# their lower-timeframe labels pass independent validation.
ENTRY_MODELS=EM1,EM3
MIN_GRADE=A
MAX_HOLD_BARS=48

# The scanner is safe by default. Enabling trading still requires the
# separate LIVE_UNLOCK token checked by the application.
ENABLE_TRADING=false
DRY_RUN=true
LIVE_UNLOCK=
MAGIC=310726
POLL_SECONDS=30

# Auto-connect to the MT5 terminal/account that is already open.
# No login, password, server, or terminal path is required.
