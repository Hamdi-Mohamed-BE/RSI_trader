# Connection and symbol discovery
MT5_PATH=
ORB_SYMBOL=US30

# Strategy clock. America/New_York handles EST/EDT automatically.
ORB_TIMEZONE=America/New_York
ORB_RANGE_START=09:30
ORB_RANGE_MINUTES=15
ORB_LAST_BREAKOUT_TIME=11:30
ORB_FLAT_TIME=16:00
ORB_WEEKDAYS_ONLY=true

# A+ setup filters
ORB_H1_MIN_SCORE=2
ORB_REQUIRE_VWAP=true
ORB_MIN_RELATIVE_VOLUME=1.05
ORB_ALLOW_DOUBLE_SWEEP=true
ORB_DOUBLE_SWEEP_BODY_MIN=0.65
ORB_BREAKOUT_BODY_MIN=0.55
ORB_BREAKOUT_EXTENSION_ATR_MIN=0.05
ORB_RANGE_ATR_MIN=0.50
ORB_RANGE_ATR_MAX=5.00
ORB_RETEST_BARS=6
ORB_RETEST_TOLERANCE_ATR=0.40
ORB_REJECTION_BODY_MIN=0.20
ORB_SL_BUFFER_ATR=0.10
ORB_ENTRY_BUFFER_POINTS=2
ORB_ENTRY_VALID_BARS=2
ORB_MAX_STOP_ATR=4.00
ORB_MAX_SPREAD_POINTS=300
ORB_SLIPPAGE_POINTS=5
ORB_REQUIRE_NEWS_FILE=false
ORB_NEWS_BLACKOUT_CSV=data/news_blackouts.csv

# Risk and exits
ORB_START_BALANCE=300
ORB_RISK_PERCENT=0.50
ORB_PARTIAL_R=1.00
ORB_PARTIAL_PERCENT=50
ORB_RUNNER_R=2.00
ORB_MOVE_SL_TO_BE=true
ORB_MAX_TRADES_PER_DAY=1

# Backtest
ORB_BACKTEST_DAYS=60
ORB_BACKTEST_START=
ORB_BACKTEST_END=

# Live execution is disabled until both switches are explicitly enabled.
ORB_LIVE_TRADING=false
ORB_PLACE_TRADES=false
ORB_POLL_SECONDS=10
ORB_MAGIC=820835
ORB_COMMENT=ORB RETEST
ORB_FIXED_LOT=0
ORB_DEVIATION_POINTS=20
