# Copy to .env and adjust. Names only; never commit real values.

# development | test | production  (production disables the dev key file)
CRYPTOLAB_ENVIRONMENT=development
CRYPTOLAB_HOST=127.0.0.1
CRYPTOLAB_PORT=8090
# CRYPTOLAB_DATA_DIR=./data
# CRYPTOLAB_DATABASE_URL=sqlite+aiosqlite:///./data/crypto_lab.sqlite

# Vault master key (32 bytes, urlsafe base64). Prefer the OS keyring (see README) over this variable.
# Generate: uv run python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# CRYPTOLAB_MASTER_KEY=

# Set true only when serving over HTTPS.
CRYPTOLAB_COOKIE_SECURE=false

# Hard safety switch. LIVE bot mode is refused while this is false.
CRYPTOLAB_LIVE_TRADING_ENABLED=false
# Optional local paper lab (keep live trading disabled). Normal auth remains the code default.
CRYPTOLAB_LOCAL_PAPER_ACCESS=false
CRYPTOLAB_AUTOSTART_WORKERS=true
CRYPTOLAB_DEFAULT_PAPER_MODE=true
CRYPTOLAB_PAPER_BALANCE_USDC=100
CRYPTOLAB_PAPER_TRADE_LIMIT_USDC=10
