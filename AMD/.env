# 21 annual trades, 85.71% WR, PF 2.86, 5.68% realized DD.
SYMBOLS=XAUUSD

STARTING_BALANCE=1000
RISK_PCT=3

ASIA_START_UTC=00:00
ASIA_END_UTC=08:00
LONDON_CONFIRM_START_UTC=08:00
LONDON_CONFIRM_END_UTC=09:00
NY_START_UTC=13:30
NY_SIGNAL_CUTOFF_UTC=16:00
FORCE_EXIT_UTC=21:00

NY_RR=2.25
NY_FALLBACK_RR=2.25
NY_FALLBACK_MINUTES=70
