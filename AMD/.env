# Auto-connect to the account already open in MetaTrader 5.
# Expanded, article-aligned AMD is now the protected default.
STRATEGY_MODEL=article
SYMBOLS=XAUUSD

STARTING_BALANCE=1000
RISK_PCT=3

ASIA_START_UTC=00:00
ASIA_END_UTC=08:00
LONDON_CONFIRM_START_UTC=08:00
LONDON_CONFIRM_END_UTC=09:00
NY_START_UTC=13:30
NY_SIGNAL_CUTOFF_UTC=16:00
FORCE_EXIT_UTC=21:00

NY_RR=4.0
NY_FALLBACK_RR=4.0
NY_FALLBACK_MINUTES=45
NY_ENTRY_BUFFER_SPREADS=2.5
# Values: limit_only, stop_only, single_fallback, dual
NY_ENTRY_MODE=stop_only
LOCK_TRIGGER_R=0.30
LOCK_PROFIT_R=0.15
NY_STOP_BUFFER_RANGE_FRACTION=0.075

# Higher-frequency AMD settings used when STRATEGY_MODEL=article.
ARTICLE_ENABLE_FADE=true
ARTICLE_ENABLE_DISTRIBUTION=true
ARTICLE_TRADE_LONDON=true
ARTICLE_TRADE_NEW_YORK=false
ARTICLE_MAX_TRADES_PER_DAY=1
ARTICLE_FADE_RR=1.5
ARTICLE_DISTRIBUTION_RR=1.5
ARTICLE_SWEEP_MIN_FRACTION=0.02
ARTICLE_SWEEP_MAX_FRACTION=0.60
ARTICLE_BREAKOUT_FRACTION=0.00
ARTICLE_RETEST_TOLERANCE_FRACTION=0.04
ARTICLE_STOP_BUFFER_FRACTION=0.03
ARTICLE_VOLUME_FACTOR=0.00
ARTICLE_LONDON_WINDOW_MINUTES=240
ARTICLE_NY_WINDOW_MINUTES=180
ARTICLE_SIGNAL_MAX_AGE_SECONDS=120

# Recent-regime gate. Values use only data available before the NY entry.
REGIME_FILTER_ENABLED=true
REGIME_ATR_DAYS=5
REGIME_ATR_PCT_MIN=1.5
REGIME_ATR_PCT_MAX=2.8
REGIME_ASIA_MEDIAN_DAYS=20
REGIME_ASIA_RATIO_MIN=0.40
REGIME_ASIA_RATIO_MAX=1.20

# Keep the new default in dry-run until its wider basket is validated.
ENABLE_TRADING=false
DRY_RUN=true
MAGIC=300730
POLL_SECONDS=15
DEVIATION_POINTS=30
LOG_LEVEL=INFO
