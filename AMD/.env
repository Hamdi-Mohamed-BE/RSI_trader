# Auto-connect to the account already open in MetaTrader 5.
# Regime-filtered XAU configuration:
# 3 months: 7 trades, 85.71% WR, PF 11.04, 3.00% realized DD.
# 1 year: 12 trades, 91.67% WR, PF 12.90, 3.00% realized DD.
SYMBOLS=XAUUSD

STARTING_BALANCE=1000
RISK_PCT=10

ASIA_START_UTC=00:00
ASIA_END_UTC=08:00
LONDON_CONFIRM_START_UTC=08:00
LONDON_CONFIRM_END_UTC=09:00
NY_START_UTC=13:30
NY_SIGNAL_CUTOFF_UTC=16:00
FORCE_EXIT_UTC=21:00

NY_RR=4.0
NY_FALLBACK_RR=4.0
NY_FALLBACK_MINUTES=45
NY_ENTRY_BUFFER_SPREADS=2.5
# Values: limit_only, stop_only, single_fallback, dual
NY_ENTRY_MODE=stop_only
LOCK_TRIGGER_R=0.30
LOCK_PROFIT_R=0.15
NY_STOP_BUFFER_RANGE_FRACTION=0.075

# Recent-regime gate. Values use only data available before the NY entry.
REGIME_FILTER_ENABLED=true
REGIME_ATR_DAYS=5
REGIME_ATR_PCT_MIN=1.5
REGIME_ATR_PCT_MAX=2.8
REGIME_ASIA_MEDIAN_DAYS=20
REGIME_ASIA_RATIO_MIN=0.40
REGIME_ASIA_RATIO_MAX=1.20

# Live execution. The bot still refuses trades that cannot respect risk sizing.
ENABLE_TRADING=true
DRY_RUN=false
MAGIC=300730
POLL_SECONDS=15
DEVIATION_POINTS=30
LOG_LEVEL=INFO
