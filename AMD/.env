# Auto-connect to the account already open in MetaTrader 5.
# Single cancel-and-replace configuration requested 2026-07-30.
# Its original 60-day sample had 5 trades and PF 9.61.
# Annual validation: 34 trades, PF 0.68, 38.79% DD, -15.79% return.
SYMBOLS=XAUUSD

STARTING_BALANCE=1000
RISK_PCT=3

ASIA_START_UTC=00:00
ASIA_END_UTC=08:00
LONDON_CONFIRM_START_UTC=08:00
LONDON_CONFIRM_END_UTC=09:00
NY_START_UTC=13:30
NY_SIGNAL_CUTOFF_UTC=16:00
FORCE_EXIT_UTC=21:00

NY_RR=5.0
NY_FALLBACK_RR=4.0
NY_FALLBACK_MINUTES=45
NY_ENTRY_BUFFER_SPREADS=1.0
# Values: limit_only, stop_only, single_fallback, dual
NY_ENTRY_MODE=single_fallback
LOCK_TRIGGER_R=0.50
LOCK_PROFIT_R=0.15
NY_STOP_BUFFER_RANGE_FRACTION=0.05

# Live execution is deliberately protected until explicitly enabled.
ENABLE_TRADING=false
DRY_RUN=true
MAGIC=300730
POLL_SECONDS=15
LOG_LEVEL=INFO
