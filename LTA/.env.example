# LTA execution
LIVE_TRADING=false
AUTO_PLACE_TRADES=false
AUTO_PREPLACE_ORDERS=false
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
START_BALANCE=300

# Choose STATIC_LOT or RISK_PERCENT.
LOT_SIZING_MODE=STATIC_LOT
STATIC_LOT=0.08
MAX_LOT_RISK_PCT=5.0
USE_BROKER_MIN_LOT_WHEN_RISK_TOO_SMALL=true

# Account and spread gates. A zero risk limit disables that limit.
MAX_RISK_PER_TRADE_PERCENT=5
MAX_DAILY_LOSS_PERCENT=0
MAX_TOTAL_DRAWDOWN_PERCENT=0
MAX_TRADES_PER_DAY=3
MAX_SPREAD_RISK_PERCENT=10
MAX_SPREAD_POINTS=0

# LTA quality and watchlist
MIN_SETUP_SCORE=90
MIN_RISK_REWARD=1.0
BACKTEST_SIGNAL_STRIDE=3
AUTO_SYMBOLS=XAUUSD
AUTO_SYMBOL_RR=XAUUSD:6
AUTO_SCAN_TIMEFRAMES=M15,M30,H1
AUTO_SCAN_INTERVAL_SECONDS=60
AUTO_ALLOWED_SESSIONS=19:00-02:00,03:00-17:00
AUTO_WEEKDAYS_ONLY=true
AUTO_BEST_SETUP_SELECTOR=true
AUTO_BEST_SETUP_CANDIDATE_LIMIT=0
AUTO_LOG_DETAIL_LIMIT=8

# LTA entry and duplicate controls
AUTO_SIGNAL_COOLDOWN_MINUTES=0
AUTO_SYMBOL_ACTIVITY_COOLDOWN_MINUTES=0
AUTO_ONE_POSITION_PER_SYMBOL=true
AUTO_ONE_POSITION_PER_SYMBOL_DIRECTION=true
AUTO_ONE_PENDING_PER_SYMBOL=true
AUTO_ONE_PENDING_PER_SYMBOL_DIRECTION=true
AUTO_LOCK_STALE_SECONDS=180
AUTO_PREFER_RETEST_LIMITS=true
AUTO_MARKET_MAX_CHASE_ATR=0.35
AUTO_PREPLACE_MIN_SCORE=92
AUTO_PREPLACE_EXPIRY_MINUTES=180

# LTA circuit breakers
AUTO_MAX_CONSECUTIVE_LOSSES=2
AUTO_SYMBOL_MAX_LOSSES_PER_DAY=0
AUTO_SYMBOL_MAX_DAILY_LOSS_R=0
AUTO_SYMBOL_LOSS_LOCKOUT_REST_OF_SESSION=false
AUTO_STRICT_SESSION_START=10:00
AUTO_STRICT_SESSION_END=13:00
AUTO_STRICT_SESSION_MIN_SCORE=96
AUTO_STRICT_SESSION_PREPLACE_MIN_SCORE=92
AUTO_STRICT_SESSION_REQUIRE_INTERNAL_BREAK=true
AUTO_FOREX_REQUIRE_HTF_AGREEMENT=true

# LTA trade management
AUTO_PROTECT_OPEN_TRADES=true
AUTO_PROTECTION_FINAL_RR=6.0
AUTO_SYMBOL_PROTECTION_RR=XAUUSD:6
AUTO_TP1_PARTIAL_CLOSE=false
AUTO_TP1_PARTIAL_CLOSE_PCT=0
AUTO_DYNAMIC_STOP_ENABLED=false
AUTO_DYNAMIC_STOP_ATR_PERIOD=14
AUTO_DYNAMIC_STOP_BASE_ATR=1.5
AUTO_DYNAMIC_STOP_VOLATILITY_LOOKBACK=50
AUTO_DYNAMIC_STOP_VOLUME_LOOKBACK=30
AUTO_DYNAMIC_STOP_HIGH_VOL_RATIO=1.20
AUTO_DYNAMIC_STOP_HIGH_VOLUME_RATIO=1.35
AUTO_DYNAMIC_STOP_MAX_ATR=3.5
AUTO_DYNAMIC_STOP_MAX_WIDEN_FACTOR=2.5
AUTO_SMART_EXIT_ENABLED=false
AUTO_SMART_EXIT_TIMEFRAME=M15
AUTO_SMART_EXIT_LOOKBACK_BARS=100
AUTO_SMART_EXIT_MIN_BARS_OPEN=2
AUTO_SMART_EXIT_PROFIT_CONFIRMATIONS=1
AUTO_SMART_EXIT_LOSS_CONFIRMATIONS=2
AUTO_SMART_EXIT_ADVERSE_ENTRY_ATR=0.25
AUTO_SMART_EXIT_MOMENTUM_BODY_ATR=0.65
AUTO_SMART_EXIT_MOMENTUM_VOLUME_RATIO=1.30
AUTO_SMART_EXIT_STRUCTURE_LOOKBACK=8

# LTA market and volume profile clocks
MARKET_SESSION_TIMEZONE=America/New_York
MARKET_DATA_TIMEZONE=UTC
LTA_PROFILE_TIMEZONE=America/New_York
LTA_PROFILE_DAY_START=18:00
LTA_PROFILE_MAIN_SESSION_START=09:30
LTA_PROFILE_MAIN_SESSION_END=16:00
LTA_PROFILE_VALUE_AREA=0.70
LTA_PROFILE_BINS=48
LTA_HIGH_VOLUME_RATIO=1.35
LTA_LOW_VOLUME_RATIO=0.75

# LTA backtesting spread model
BACKTEST_SPREAD_ADJUST=true
BACKTEST_SPREAD_MULTIPLIER=1.0
BACKTEST_MAX_SPREAD_R=0.10
