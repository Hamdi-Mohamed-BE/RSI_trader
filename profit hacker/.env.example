# Telegram user API credentials from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_SESSION=profit_hacker.session

# The Telegram Web URL in your request ends with this channel id.
TELEGRAM_CHANNEL=-1001303328644
RECENT_MESSAGE_LOG_COUNT=5

# MT5 terminal and optional account login.
# Leave login/password/server blank if your terminal is already logged in.
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Keep true until you have confirmed the parser and broker symbol mapping.
DRY_RUN=true

# Risk and signal lifetime.
RISK_PERCENT=5
MAX_SIGNAL_AGE_SECONDS=180
PENDING_ORDER_TTL_SECONDS=180

# single: one order using the last TP, move SL to break-even once TP1 price is touched.
# split: split total volume across all TP levels when broker minimum lot allows it.
ORDER_MODE=single

# Set if broker symbol names differ from the Telegram text.
# Example: NAS100=NAS100.cash,US100=USTECm,XAUUSD=XAUUSDm
# Leave empty to auto-discover suffixes such as GBPUSDm and XAUUSDm.
SYMBOL_MAP=
AUTO_DISCOVER_SYMBOLS=true

# 0 disables max-drift checks for market signals that include an explicit entry price.
MAX_ENTRY_DRIFT_POINTS=0
BREAK_EVEN_ENABLED=true
BREAK_EVEN_OFFSET_POINTS=0

MT5_MAGIC=1303328644
TRADE_COMMENT_PREFIX=PH
WATCH_INTERVAL_SECONDS=2
STATE_DB=state/profit_hacker.sqlite3
LOG_LEVEL=INFO
