# Live bot: uses whichever account is already connected in the open MT5 terminal.
# Live execution is enabled. Starting the worker can place/close orders.
LIVE_TRADING=true
GOLD_SYMBOL_HINT=AUTO
TIMEFRAME=H4
PIVOT_DISTANCE=6
MAX_SAME_DIRECTION_LEGS=1
RISK_PCT_PER_TRADE=3.0
MAXIMUM_LOT=100.0
CLOSE_ON_OPPOSITE=true
ENTRY_WINDOW_MINUTES=10
POLL_SECONDS=15
HISTORY_BARS=100
DEVIATION_POINTS=50
MAX_TICK_AGE_SECONDS=120
MAGIC_NUMBER=3082026
ORDER_COMMENT=EMA3_H4_PIVOT
STATE_FILE=runtime/state.json
LOG_FILE=logs/ema3-live.log

# One year total: first 75% selects the exit, final 25% is unseen validation.
HISTORY_DAYS=365
TRAIN_FRACTION=0.75

# Normalized portfolio assumptions used to compare the best mix.
STARTING_BALANCE=1000
RISK_PCT=1.0
MAX_PORTFOLIO_RISK_PCT=3.0

# Fixed targets and trailing variants to test.
FIXED_RRS=1.0,1.5,2.0,2.5,3.0,4.0,5.0
TRAIL_START_RS=1.0,1.5,2.0,3.0
TRAIL_DISTANCE_RS=0.5,1.0,1.5,2.0

# Minimum training sample for an exit configuration to be selectable.
MIN_TRAIN_TRADES=12
MIN_TRAIN_PROFIT_FACTOR=1.05
MIN_VALIDATION_TRADES=4
REPORT_DIR=reports\optimization

# Research universe. Canonical names are resolved to the connected broker.
SYMBOLS=XAUUSD,XAGUSD,BTCUSD,ETHUSD,EURJPY,AUDCAD,AUDCHF,GBPJPY,GBPUSD,US30
