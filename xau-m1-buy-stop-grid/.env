MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# Symbol discovery starts from this name and auto-finds the broker variant.
XAU_SYMBOL=XAUUSD

# Set true to actually send orders. False only prints what would be placed.
PLACE_ORDERS=true

# LOT settings — realistic for $100 when news leverage is capped to 1:200.
FIXED_LOT=0.01

# Buy-stop ladder settings.
ORDER_SIDE=both
ORDER_COUNT=10
BUY_ORDER_COUNT=5
SELL_ORDER_COUNT=5

FIRST_OFFSET_USD=10.00
BUY_FIRST_OFFSET_USD=10.00
SELL_FIRST_OFFSET_USD=10.00

PRICE_DIFF_USD=4.00
BUY_PRICE_DIFF_USD=4
SELL_PRICE_DIFF_USD=4


# Runner protection. Opposite-candle SL matches the news-straddle model:
# buy SL = setup candle low - SL_ROOM_USD
# sell SL = setup candle high + SL_ROOM_USD
SL_MODE=opposite_candle
SL_ROOM_USD=20
SL_DISTANCE_USD=0
TP_DISTANCE_USD=0

# Runner management. No fixed TP; trail after the move expands.
MANAGE_RUNNER=true
RUNNER_TRAIL_START_R=7
RUNNER_TRAIL_DISTANCE_R=1
RUNNER_MONITOR_MINUTES=120
CANCEL_OPPOSITE_ON_TRIGGER=true

# MT5 execution controls.
MAGIC=7143001
DEVIATION_POINTS=30
EXPIRATION_MINUTES=3
SKIP_DUPLICATE_PENDING=false
DUPLICATE_PRICE_TOLERANCE_USD=0.10
RESPECT_BROKER_MIN_DISTANCE=true

# Read-only FX news-pulse backtest. This never sends orders.
NEWS_BACKTEST_START_BALANCE=100
NEWS_BACKTEST_LEVERAGE=200
NEWS_MARGIN_USE_PCT=100
NEWS_OPTIMIZE=true
NEWS_OFFSET_PIPS=1
NEWS_OFFSET_ATR=0.25
NEWS_SPREAD_MULTIPLE=0
NEWS_SL_BUFFER_PIPS=1
NEWS_SL_BUFFER_ATR=0.25
NEWS_EXPIRY_MINUTES=3
NEWS_HOLD_MINUTES=120
NEWS_TRAIL_START_R=5
NEWS_TRAIL_DISTANCE_R=0.5
NEWS_SLIPPAGE_SPREADS=0.5
# This broker stores M1 history on UTC+3 server time.
NEWS_MT5_HISTORY_OFFSET_HOURS=3
NEWS_OPT_OFFSET_PIPS=1,2,3,5
NEWS_OPT_SL_BUFFER_PIPS=1,2,3,5
NEWS_OPT_EXPIRY_MINUTES=3,5
NEWS_OPT_TRAIL_START_R=1,2,3,5
NEWS_OPT_TRAIL_DISTANCE_R=0.5,1
