# Copy this file to .env (same folder). .env is never committed.

# user = post from YOUR Telegram account, logged in by scanning a QR code (recommended here)
# bot  = post through a @BotFather bot (needs TELEGRAM_BOT_TOKEN and the bot as channel admin)
TELEGRAM_MODE=user

# --- user mode: create these once at https://my.telegram.org -> API development tools (any app name). Keep them private.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- bot mode only: from @BotFather (/newbot). Keep it secret: anyone with it can post as your bot.
TELEGRAM_BOT_TOKEN=

# Channel: the numeric id from Telegram Web (web.telegram.org/a/#-100...), or @yourchannel. In user mode you can leave it empty and pick
# the channel from a list after the QR login.
TELEGRAM_CHAT_ID=
# Optional: chat for connection-lost / error alerts (kept out of the channel). Empty = your Saved Messages in user mode, console in bot mode.
TELEGRAM_ADMIN_CHAT_ID=

# What the signals show (true / false)
# Shown under every new signal / pending order instead of the lot size (empty = no note)
SIGNALS_RISK_NOTE=Risk management is required: use the minimum available lot size or risk max 5% per trade.
# Money results reveal the account size; off by default
SIGNALS_SHOW_PROFIT=true
SIGNALS_SHOW_R=true
SIGNALS_SHOW_PENDING=false
# Deposits / withdrawals (no amounts unless SHOW_PROFIT=true)
SIGNALS_SHOW_ACCOUNT_EVENTS=true
# Post updates / closes as replies to the original signal
SIGNALS_REPLY_TO_SIGNAL=true
# First start only: also post positions that are already open
SIGNALS_ANNOUNCE_OPEN_ON_START=true

# Daily recap: one summary of the day's closed trades (W/L, net R and money, per bot, still-open positions) Mon-Fri at this
# New York time (17:00 = the FX / CFD daily close; DST handled). Friday's recap closes the week.
SIGNALS_DAILY_RECAP=true
SIGNALS_RECAP_TIME=17:00

# Polling and catch-up after a restart
SIGNALS_POLL_SECONDS=1
SIGNALS_CATCHUP_HOURS=24

# Filters by magic number (comma list). Empty = every trade on the account, manual trades included (magic 0).
SIGNALS_ONLY_MAGICS=
SIGNALS_IGNORE_MAGICS=

# Extra symbol names, e.g. USTEC=US100,XAUUSD=GOLD (broker suffixes like XAUUSDm / EURUSD.raw are stripped automatically)
SIGNALS_SYMBOL_ALIASES=
# SL / TP move messages (trailing stops post every minute). Off = entries, exits and the daily recap only.
SIGNALS_SHOW_UPDATES=false
