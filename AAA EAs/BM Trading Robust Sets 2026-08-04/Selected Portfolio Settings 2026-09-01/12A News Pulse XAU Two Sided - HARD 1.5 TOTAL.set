InpEnableTrading=true
InpMarketFallbackOnCrossedLevel=true
InpUseXauEventSpecific=true
; v2.20: all XAU events current Ask/Bid offset6, initial SL10, close30s.
; NFP T-10s noTP/noTrail; CPI T-5s noTP trail1R/distance10.
; FOMC T-60s TP5.5R trail0.5R/distance4; crossed levels use market fallback.
; Geometry inputs below are compatibility fallbacks; event-specific source rules override them on XAU/GOLD.
InpEnableBuySide=true
InpEnableSellSide=true
InpRiskPercent=0.75
InpAdaptivePortfolioControls=false
InpMagic=861301
InpMaxDeviationPoints=100
InpUseEconomicCalendar=true
InpWatchNFP=true
InpWatchCPI=true
InpWatchFOMC=true
InpPlacementLeadSeconds=30
InpMaxQuoteAgeSeconds=5
InpCalendarLookaheadDays=8
InpCalendarRefreshSeconds=300
InpEntryOffsetPrice=6
InpStopLossPrice=10
InpTrailStartR=1.5
InpTrailDistancePrice=15
InpForceCloseSecondsAfterEvent=30
InpTesterServerClockMode=0
InpUseDynamicTrailingSL=false
InpDynamicTriggerFraction=0.50
InpDynamicLockFraction=0.20
InpResearchSession=0
InpResearchBrokerUtcOffsetMinutes=0
