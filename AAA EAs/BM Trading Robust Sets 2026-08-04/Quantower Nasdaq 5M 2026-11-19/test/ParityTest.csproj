<Project Sdk="Microsoft.NET.Sdk">
  <!-- Console parity test: runs the SAME N5Logic.cs the Quantower strategy uses on MT5 USTEC M5 bars and writes the daily signals. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\src\N5Logic.cs" Link="N5Logic.cs" />
  </ItemGroup>
</Project>
