; MT5 research-only adaptation of the retrieved Roboquant preset
; Only risk_mode changes from fixed $3000 to 1% equity; no optimisation
range_bars=1
rr_target=0.4
risk_mode=0
risk_pct=1.0
risk_usd=3000
stop_mode=1
atr_stop_mult=0.4
atr_period=14
max_stop_pts=0
use_rvol=true
min_rvol=1.0
rvol_period=20
use_atr_regime=true
min_atr_pct=0.10
max_atr_pct=0.60
cutoff_hhmm=1500
flat_hhmm=1555
one_trade_per_day=true
allow_long=true
allow_short=true
