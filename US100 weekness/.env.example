# Broker connection is automatic: keep the intended MT5 terminal/account open.
CANONICAL_SYMBOL=US100
HISTORY_DAYS=365
RISK_PCT=2.0
MAX_DAILY_RISK_PCT=2.0

# Training-selected S2B continuation profile. In this model, the notes'
# 50/100 values are literal Nasdaq price units.
NOTE_POINT_TO_PRICE=1.0
STRATEGY_MODE=S2B
PENDING_MODE=OCO
S2A_ENTRY_MODEL=REFERENCE_PAIR
S2B_ENTRY_MODEL=CLOSE_PLUS_50
TARGET_RR=3.0
RUNNER_TRAIL_BARS=1
RUNNER_BUFFER_POINTS=5
ORDER_EXPIRY_NY=12:00
SESSION_EXIT_NY=16:00
MAX_SPREAD_PRICE=8
SLIPPAGE_PRICE=1.0

# Execution remains locked until unseen validation passes.
ENABLE_TRADING=false
DRY_RUN=true
LIVE_UNLOCK=
MAGIC=310731
POLL_SECONDS=15
