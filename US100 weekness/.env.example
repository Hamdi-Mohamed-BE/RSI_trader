# MT5 auto-connects to the terminal/account already open on this computer.
AUTO_DISCOVER_SYMBOL=true
US100_SYMBOL=
US100_ALIASES=US100,NAS100,USTEC,UT100,NDX100,NDX,NASDAQ
US100_PIP_SIZE=1.0

# Safety: both must be changed deliberately before any order can be sent.
ENABLE_TRADING=false
DRY_RUN=true
DEMO_ONLY=true
MAGIC_NUMBER=1000930
ORDER_COMMENT=US100_NY

# Risk controls
RISK_MODE=percent
RISK_PERCENT=0.50
FIXED_LOT=0.01
MAX_RISK_CASH=100
MAX_DAILY_LOSS_PERCENT=1.0
MAX_COMBINED_RISK_PERCENT=1.0
MAX_SPREAD_PIPS=5
MAX_SLIPPAGE_PIPS=2
MIN_STOP_PIPS=10
MAX_STOP_PIPS=250
FRIDAY_FILTER=false
NEWS_FILTER_ENABLED=false
NEWS_BLACKOUT_MINUTES=15

# Strategy A
STRATEGY_A_ENABLED=true
NY_OPEN=09:30
A_STOP_PIPS=50
A_FIXED_TARGET_PIPS=100
A_RUNNER_METHOD=previous_m15
A_TRAIL_BUFFER_PIPS=0
A_BREAK_EVEN_R=0
A_FORCE_EXIT=15:55

# Strategy B
STRATEGY_B_ENABLED=true
B1_ENABLED=true
B2_ENABLED=true
SECOND_CANDLE_START=09:45
SECOND_CANDLE_END=10:00
DOJI_BODY_PIPS=2
B1_STOP_REFERENCE=london_session_high
B1_STOP_BUFFER_PIPS=2
B1_RR=2
B2_PULLBACK_MODE=close_plus_fixed
B2_ENTRY_PIPS=50
B2_STOP_PIPS=100
B2_RR=2
B2_EXPIRY=12:00
LONDON_START=03:00

# Backtest assumptions
STARTING_BALANCE=10000
COMMISSION_PER_LOT_ROUND_TURN=0
SLIPPAGE_PIPS=1
DATA_DIR=data
REPORT_DIR=reports
LOG_DIR=logs
STATE_DIR=state
