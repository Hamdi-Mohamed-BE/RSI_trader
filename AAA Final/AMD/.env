# Auto-connect to the account already open in MetaTrader 5.
# Expanded, article-aligned AMD is now the protected default.
STRATEGY_MODEL=article
SYMBOLS=XAUUSD

STARTING_BALANCE=1000
RISK_PCT=3

ASIA_START_UTC=00:00
ASIA_END_UTC=08:00
LONDON_CONFIRM_START_UTC=08:00
LONDON_CONFIRM_END_UTC=09:00
NY_START_UTC=13:30
NY_SIGNAL_CUTOFF_UTC=16:00
FORCE_EXIT_UTC=21:00

NY_RR=4.0
NY_FALLBACK_RR=4.0
NY_FALLBACK_MINUTES=45
NY_ENTRY_BUFFER_SPREADS=2.5
# Values: limit_only, stop_only, single_fallback, dual
NY_ENTRY_MODE=stop_only
LOCK_TRIGGER_R=0.30
LOCK_PROFIT_R=0.15
NY_STOP_BUFFER_RANGE_FRACTION=0.075

# Higher-frequency AMD settings used when STRATEGY_MODEL=article.
ARTICLE_ENABLE_FADE=true
ARTICLE_ENABLE_DISTRIBUTION=false
ARTICLE_TRADE_LONDON=true
ARTICLE_TRADE_NEW_YORK=false
ARTICLE_MAX_TRADES_PER_DAY=1
ARTICLE_FADE_RR=2.0
ARTICLE_DISTRIBUTION_RR=2.0
ARTICLE_SWEEP_MIN_FRACTION=0.02
ARTICLE_SWEEP_MAX_FRACTION=0.60
ARTICLE_BREAKOUT_FRACTION=0.00
ARTICLE_RETEST_TOLERANCE_FRACTION=0.04
ARTICLE_STOP_BUFFER_FRACTION=0.03
ARTICLE_VOLUME_FACTOR=0.00
ARTICLE_REQUIRE_DIRECTIONAL_CONFIRMATION=false
ARTICLE_MIN_BODY_FRACTION=0.00
ARTICLE_MIN_CLOSE_LOCATION=0.00
ARTICLE_FADE_RECLAIM_FRACTION=0.00
ARTICLE_FADE_CONFIRMATION_MODE=immediate
ARTICLE_FADE_MSS_LOOKAHEAD_BARS=6
ARTICLE_DISTRIBUTION_HOLD_FRACTION=0.00
ARTICLE_BREAKOUT_MAX_FRACTION=0.00
ARTICLE_MAX_RISK_FRACTION=0.00
ARTICLE_TREND_FILTER_MODE=none
ARTICLE_TREND_FAST=8
ARTICLE_TREND_SLOW=24
ARTICLE_TREND_PRICE_ALIGNMENT=true
ARTICLE_LONDON_WINDOW_MINUTES=180
ARTICLE_NY_WINDOW_MINUTES=180
ARTICLE_SIGNAL_MAX_AGE_SECONDS=120

# Recent-regime gate. Values use only data available before the NY entry.
REGIME_FILTER_ENABLED=true
REGIME_ATR_DAYS=5
REGIME_ATR_PCT_MIN=1.5
REGIME_ATR_PCT_MAX=2.8
REGIME_USE_RELATIVE_ATR=true
REGIME_ATR_MEDIAN_DAYS=30
REGIME_ATR_RATIO_MIN=0.65
REGIME_ATR_RATIO_MAX=1.00
REGIME_ASIA_MEDIAN_DAYS=20
REGIME_ASIA_RATIO_MIN=0.60
REGIME_ASIA_RATIO_MAX=1.00

# Live execution explicitly enabled by the owner. This profile failed the
# robustness audit, so use it only on an account whose loss is acceptable.
ENABLE_TRADING=true
DRY_RUN=false
MODEL_APPROVED=true
MAGIC=300730
POLL_SECONDS=15
DEVIATION_POINTS=30
LOG_LEVEL=INFO
