# Live bot: uses whichever account is already connected in the open MT5 terminal.
LIVE_TRADING=false
GOLD_SYMBOL_HINT=AUTO
TIMEFRAME=H4
# Supported live values: M1, M5, M15, H1, H4.
PIVOT_DISTANCE=5
MAX_SAME_DIRECTION_LEGS=1
RISK_PCT_PER_TRADE=1.0
# Optional loss-streak progression. Keep disabled until independently validated.
# Exact rule if enabled: next risk = 1% * 1.6^consecutive_losses; a win resets it.
RISK_PROGRESSION_ENABLED=false
RISK_PROGRESSION_MULTIPLIER=1.6
# Required live safety ceiling. Research can explicitly run uncapped.
RISK_PROGRESSION_MAX_PCT=3.2
MAXIMUM_LOT=100.0
CLOSE_ON_OPPOSITE=true
EXIT_MODE=trail
TRAILING_ENABLED=false
TARGET_R=1.7
MAX_TARGET_R=1.7
TRAIL_START_R=1.0
TRAIL_DISTANCE_R=1.0
SIGNAL_FILTER=ema200_slope
EMA_SLOPE_BARS=6
ENTRY_WINDOW_MINUTES=10
POLL_SECONDS=15
HISTORY_BARS=300
DEVIATION_POINTS=50
MAX_TICK_AGE_SECONDS=120
MAGIC_NUMBER=3082026
ORDER_COMMENT=EMA3 A H4 EMA200 trail
STATE_FILE=runtime/state.json
LOG_FILE=logs/ema3-live.log

# Research settings.
SYMBOLS=XAUUSD,XAGUSD,BTCUSD,ETHUSD,EURJPY,AUDCAD,AUDCHF,GBPJPY,GBPUSD,US30
HISTORY_DAYS=365
TRAIN_FRACTION=0.75
STARTING_BALANCE=1000
RISK_PCT=1.0
BACKTEST_RISK_PCT=1.0
MAX_PORTFOLIO_RISK_PCT=1.0
FIXED_RRS=1.0,1.5,1.7
TRAIL_START_RS=1.0,1.5,2.0,3.0
TRAIL_DISTANCE_RS=0.5,1.0,1.5,2.0
MIN_TRAIN_TRADES=12
MIN_TRAIN_PROFIT_FACTOR=1.05
MIN_VALIDATION_TRADES=4
REPORT_DIR=reports\optimization
