# Auto-connect to the currently open MT5 terminal and discover its US100 name.
CANONICAL_SYMBOL=US100
SYMBOLS=US100,XAUUSD

# Live profile requested by the owner. Starting the BAT file can place orders.
ENABLE_TRADING=true
DRY_RUN=false
LIVE_UNLOCK=I_ACCEPT_DMC_LIVE_RISK
RISK_PCT=2.0
MAX_TOTAL_RISK_PCT=4.0
MAGIC=1082601

# Improved strategy: D1/H4 bias + confirmed H1 body gain/failure retest.
NY_TIMEZONE=America/New_York
NY_OPEN=09:30
PENDING_EXPIRY=16:00
H4_HOURS=4
D1_MIN_BODY_FRACTION=0.20
H4_MIN_BODY_FRACTION=0.20
STRONG_BODY_FRACTION=0.50
PULLBACK_POINTS=25
STOP_POINTS=45
TRAIL_START_R=2.0
TRAIL_DISTANCE_R=1.5
MAX_HOLD_HOURS=24
MAX_TRADES_PER_WEEK=3
POLL_SECONDS=15
DEVIATION_POINTS=30
MAX_SPREAD_POINTS=12

H1_CONFIRMATION_MODE=previous_body
ENTRY_MODE=reaction_retest
STOP_MODE=fixed
TARGET_MODE=trail

# Research-only transcript variants. The current default does not use these.
STRUCTURE_STOP_BUFFER_POINTS=10
MINIMUM_STOP_POINTS=25
MAXIMUM_STOP_POINTS=100
BODY_LEVEL_DAILY_LOOKBACK=10
BODY_LEVEL_WEEKLY_LOOKBACK=4
BODY_LEVEL_MONTHLY_LOOKBACK=3
MINIMUM_TARGET_R=0.50
MAXIMUM_TARGET_R=6.0

# Per-market distances. All other DmC rules remain identical.
US100_STOP_POINTS=45
US100_TRAIL_START_R=2.0
US100_TRAIL_DISTANCE_R=1.5
US100_MAX_HOLD_HOURS=24
US100_MAX_SPREAD_POINTS=12
XAUUSD_STOP_POINTS=22.5
XAUUSD_TRAIL_START_R=2.0
XAUUSD_TRAIL_DISTANCE_R=1.5
XAUUSD_MAX_HOLD_HOURS=24
XAUUSD_MAX_SPREAD_POINTS=40

ORDER_COMMENT_REASON=D1H4+H1 body retest
