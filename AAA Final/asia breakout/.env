
# Live orders are allowed because both switches below are deliberately enabled.
# Aggressive, exposure-controlled live profile selected 2026-07-29.
ENABLE_TRADING=true
DRY_RUN=false

RISK_PCT=1.00
MAX_BASKET_RISK_PCT=1.00
MAX_LIVE_RISK_PCT=1.00
MAX_TARGET_RR=3.0
TRAILING_ENABLED=true
STARTING_BALANCE=1000
ASIA_START_UTC=00:00
ASIA_END_UTC=08:00
ENTRY_CUTOFF_UTC=13:00
FORCE_EXIT_UTC=17:00
ADR_DAYS=14
MAGIC=290729
LOG_DIR=logs
LOG_LEVEL=INFO

# Shared fallback only. The selected per-symbol settings are saved in
# configs\core4_basket.json.
ENTRY_MODE=mechanical_oco
STOP_MODE=midpoint
RR=1.5
EXIT_MODE=fixed
TRAIL_START_R=1.0
TRAIL_DISTANCE_R=1.0
BUFFER_RANGE_FRACTION=0.03
MIN_RANGE_ADR_FRACTION=0.05
MAX_RANGE_ADR_FRACTION=0.35
RETEST_BARS=4

# The canonical basket comes from this file. Exact broker symbols are
# discovered from the connected MT5 account at runtime.
SYMBOLS=XAUUSD
SYMBOL_CONFIG_PATH=configs\selected_xau_portfolio.json

# Shared all-bot XAU portfolio guard.
SHARED_XAU_RISK_CAP_PCT=4.00
SELECTED_XAU_MAGIC_RISKS=3082026:1.00,290729:1.00,1082601:1.00,300730:1.00
