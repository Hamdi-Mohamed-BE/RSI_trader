# Uses the account already connected in the open MetaTrader 5 terminal.
CANONICAL_SYMBOL=XAUUSD
MAGIC=4080401

# Selected by chronological train / validation / holdout testing.
MODE=momentum
RISK_PCT=0.50
GRID_LEVELS=3
FIRST_OFFSET_ATR=0.10
GRID_STEP_ATR=0.25
STOP_EXTRA_ATR=1.00
TARGET_ATR=2.00
BE_TRIGGER_R=0
BE_LOCK_R=0
TRAIL_START_R=0
TRAIL_DISTANCE_ATR=0.80
PENDING_EXPIRY_BARS=12
MAX_HOLD_BARS=72
COOLDOWN_BARS=12
SESSION_START_UTC=6
SESSION_END_UTC=19
ADX_MIN=18
ADX_MAX=50
RANGE_ADX_MAX=20
RSI_LONG_MAX=45
RSI_SHORT_MIN=55

# Basket and account circuit breakers.
MAX_DAILY_LOSS_PCT=1.00
MAX_EQUITY_DD_PCT=6.00
MIN_MARGIN_LEVEL_PCT=500
MAX_SPREAD_PRICE=0.80
POLL_SECONDS=15

# Live-ready. No process or order is started by configuration alone.
ENABLE_TRADING=true
DRY_RUN=false
LIVE_UNLOCK=I_ACCEPT_XAU_GRID_LIVE_RISK
